---
import { symbols } from '../icons/sprite.js';

/**
 * One inline SVG sprite, referenced everywhere with <use href="#i-name">.
 *
 * The symbols themselves live in src/icons/sprite.js so Storybook renders the
 * same glyphs from the same source.
 *
 * width/height attributes AND an inline style, deliberately: relying on a
 * stylesheet rule alone means that between first paint and the CSS arriving, an
 * SVG with no dimensions renders at its default 300x150 and shoves the header
 * down the page.
 */
---

<svg class="sprite" aria-hidden="true" focusable="false" width="0" height="0"
     style="position:absolute;width:0;height:0;overflow:hidden">
  <defs set:html={symbols} />
</svg>
