---
import { site, coverage, people } from '../data/site.js';

/**
 * The About page: what the show is, who makes it, what it covers.
 *
 * Bios are the hosts' own words, copyedited for spelling and run-ons only.
 */
---

<section class="section" id="about">
  <div class="wrap">
    <div class="about reveal">
      <h2>About Us</h2>
      <p class="body-lg">
        Two mediocre runners and a dog with strong opinions.
      </p>
    </div>

    <div class="bios">
      {people.map((person, i) => (
        <article class="bio reveal" data-delay={i === 0 ? '1' : '2'}>
          <header class="bio-head">
            <h3 class="bio-name">{person.name}</h3>
            <p class="bio-role">{person.role}</p>
          </header>
          {person.bio.map((paragraph) => <p>{paragraph}</p>)}

          {/* Set type standing in for a real signature. Give the person a
              signatureImage and this swaps to the scan with nothing else to
              change — which is the only reason it is a branch and not markup. */}
          {person.signatureImage ? (
            <img class="bio-sign-img" src={person.signatureImage} alt={person.name} loading="lazy" />
          ) : person.signature ? (
            <p class="bio-sign" aria-hidden="true">{person.signature}</p>
          ) : null}
        </article>
      ))}
    </div>

    <div class="reveal" data-delay="2">
      <h2 class="covers-heading">What We Cover</h2>
      <ul class="covers">
        {coverage.map((item) => (
          <li>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
