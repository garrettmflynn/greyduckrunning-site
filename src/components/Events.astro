---
import EventList from './EventList.astro';
import events from '../data/events.json';

/**
 * The race calendar.
 *
 * Google Calendar is where Christian and Lauren edit; this is where it is
 * published. Rendering it ourselves rather than embedding Google's widget buys
 * three things the embed cannot: it matches the site, it works with JavaScript
 * off, and — most usefully — every event carries its own registration link in
 * the calendar description, which becomes the row itself.
 *
 * Built to survive a full season rather than the current three months:
 *
 *   - Months are the unit. A flat list of a hundred dates gives no sense of
 *     what is soon versus what is in October, and the jump links make a long
 *     page navigable without paginating it into separate requests.
 *   - Past races stay, in a closed <details> at the bottom. They are still
 *     worth linking to, and dropping them meant an un-updated calendar left
 *     the page with nothing on it at all.
 *   - There is a real empty state, because "no upcoming races" is a thing that
 *     will eventually be true for a week in February.
 */

const groupByMonth = (list) => {
  const months = [];
  for (const event of list) {
    const last = months[months.length - 1];
    if (last && last.key === event.monthKey) last.events.push(event);
    else months.push({ key: event.monthKey, label: event.monthLabel, short: event.monthShort, events: [event] });
  }
  return months;
};

const upcoming = groupByMonth(events.filter((e) => !e.past));
// Most recent first: looking back, you want last weekend before last winter.
const past = groupByMonth(events.filter((e) => e.past)).reverse();
const pastCount = events.filter((e) => e.past).length;

const feed = `${Astro.site?.origin ?? 'https://greyduckrunning.com'}/events.ics`;
const webcal = feed.replace(/^https?:/, 'webcal:');
const google = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(feed)}`;
---

<section class="section" id="races">
  <div class="wrap">
    <div class="events-head reveal">
      <div>
        <h2>Race Calendar</h2>
        <p class="body-lg">
          The races we're covering, and the ones we've signed up for.
        </p>
      </div>

      <div class="events-subscribe">
        {/* Not just "Subscribe": the header already has a Subscribe button for
            the podcast, and two of them on screen at once is a coin toss. */}
        <a class="cta" href={webcal} data-brand="calendar" aria-label="Subscribe to the race calendar">
          <svg class="ico" aria-hidden="true"><use href="#i-calendar"></use></svg>
          <span>Subscribe to Races</span>
        </a>
        <a class="events-alt" href={google} target="_blank" rel="noopener">Add to Google Calendar</a>
      </div>
    </div>

    {/* Jump links appear only once there is enough calendar to be worth
        skipping through. */}
    {upcoming.length > 2 && (
      <nav class="month-nav reveal" aria-label="Jump to month">
        {upcoming.map((month) => (
          <a class="month-chip" href={`#m-${month.key}`}>
            {month.short}
            <span class="month-chip-count">{month.events.length}</span>
          </a>
        ))}
      </nav>
    )}

    {upcoming.length === 0 && (
      <p class="events-empty reveal">
        Nothing on the calendar just yet. Subscribe and it will turn up as soon
        as it does.
      </p>
    )}

    {upcoming.map((month, i) => (
      <div class="events-month reveal" id={`m-${month.key}`} data-delay={i === 0 ? '1' : '2'}>
        <h3 class="events-month-label">{month.label}</h3>
        <EventList events={month.events} />
      </div>
    ))}

    {pastCount > 0 && (
      <details class="events-past reveal" data-delay="2">
        <summary>
          Earlier races
          <span class="events-past-count">{pastCount}</span>
        </summary>
        {past.map((month) => (
          <div class="events-month">
            <h3 class="events-month-label">{month.label}</h3>
            <EventList events={month.events} />
          </div>
        ))}
      </details>
    )}
  </div>
</section>
