---
import EpisodeItem from './EpisodeItem.astro';
import episodes from '../data/episodes.json';
import { links } from '../data/site.js';

/**
 * The episode card. Compact rows only — playback state lives in the sticky
 * PlayerBar, which also owns the single <audio> element.
 *
 * This replaced a Spotify iframe that could not be styled (cross-origin) and
 * rendered only the newest episode to logged-out visitors.
 */
---

<div class="player reveal" data-delay="2">
  <div class="player-head">
    <h2 class="player-title">Episodes <span class="player-count">{episodes.length}</span></h2>
    <a class="player-rss" href={links.rss} aria-label="Subscribe by RSS">RSS</a>
  </div>

  {/* Scrolls rather than growing. At roughly weekly cadence this list is 50+
      within a year, and an unbounded card would push the page — and the
      two-column hero — out of shape. tabindex makes the region reachable by
      keyboard, which a scrollable container needs to satisfy WCAG 2.1.1. */}
  <div class="episodes-scroll" tabindex="0" role="group" aria-label="Episode list, scrollable">
    <ol class="episodes">
      {episodes.map((episode, i) => (
        <EpisodeItem episode={episode} latest={i === 0} />
      ))}
    </ol>
  </div>
</div>
