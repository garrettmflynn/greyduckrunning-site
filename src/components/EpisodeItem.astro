---
import Icon from './Icon.astro';

/**
 * One episode row — compact by design.
 *
 * Playback state lives in the sticky PlayerBar, not here. Per-row progress bars
 * meant six copies of a control only one of which could ever be active, and the
 * rows had to grow to make room for something usually hidden.
 *
 * Server-rendered: the episode list is the site's primary content, so it ships
 * in the HTML for search engines and works with JavaScript off. The player
 * script enhances this markup rather than producing it.
 */
interface Props {
  episode: {
    title: string;
    audio: string;
    duration: string;
    seconds: number;
    iso: string;
    label: string;
    blurb: string;
    art: string;
  };
  latest?: boolean;
}
const { episode, latest = false } = Astro.props;
---

<li class="episode">
  <button
    class="ep-play"
    type="button"
    data-audio={episode.audio}
    data-title={episode.title}
    data-art={episode.art}
    data-seconds={episode.seconds}
    aria-label={`Play ${episode.title}`}
  >
    <Icon name="play" class="ep-icon-play" />
    <Icon name="pause" class="ep-icon-pause" />
  </button>

  {episode.art && (
    <img class="ep-art" src={episode.art} width="44" height="44" alt="" loading="lazy" />
  )}

  <div class="ep-body">
    <h3 class="ep-title">
      {episode.title}
      {latest && <span class="ep-flag">Latest</span>}
    </h3>
    <p class="ep-meta">
      <time datetime={episode.iso}>{episode.label}</time>
      {episode.duration && <> · {episode.duration}</>}
    </p>
  </div>
</li>
