---
import Icon from './Icon.astro';

/**
 * One episode row, rendered at build time from the RSS feed.
 *
 * Server-rendered on purpose: the episode list is the site's primary content,
 * so it needs to be in the HTML for search engines and to work with JavaScript
 * off. The player script enhances this markup rather than producing it.
 *
 * The featured variant is the newest episode, given artwork at 160px and its
 * own blurb; the rest are compact rows.
 */
interface Props {
  episode: {
    title: string;
    audio: string;
    duration: string;
    iso: string;
    label: string;
    blurb: string;
    art: string;
  };
  featured?: boolean;
}
const { episode, featured = false } = Astro.props;
---

<li class:list={['episode', featured && 'episode--featured']}>
  {episode.art && (
    <img
      class="ep-art"
      src={episode.art}
      width={featured ? 160 : 64}
      height={featured ? 160 : 64}
      alt=""
      loading={featured ? 'eager' : 'lazy'}
    />
  )}

  <div class="ep-body">
    {featured && <p class="ep-tag">Latest episode</p>}

    <h3 class="ep-title">{episode.title}</h3>

    <p class="ep-meta">
      <time datetime={episode.iso}>{episode.label}</time>
      {episode.duration && <> · {episode.duration}</>}
    </p>

    {featured && episode.blurb && <p class="ep-blurb">{episode.blurb}</p>}

    {featured && (
      <button class="ep-play" type="button" data-audio={episode.audio} aria-label={`Play ${episode.title}`}>
        <Icon name="play" class="ep-icon-play" />
        <Icon name="pause" class="ep-icon-pause" />
      </button>
    )}

    <div class="ep-progress" hidden>
      <div class="ep-bar"><span></span></div>
      <span class="ep-time">0:00</span>
    </div>
  </div>

  {!featured && (
    <button class="ep-play" type="button" data-audio={episode.audio} aria-label={`Play ${episode.title}`}>
      <Icon name="play" class="ep-icon-play" />
      <Icon name="pause" class="ep-icon-pause" />
    </button>
  )}
</li>
