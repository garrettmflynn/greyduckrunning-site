---
import EventList from './EventList.astro';
import events from '../data/events.json';

/**
 * The next few races, on the home page. The full calendar lives at /races.
 *
 * Four, because that reliably spans more than one weekend without turning the
 * home page into the calendar page. Dates carry their month here rather than
 * their weekday — out of the month-grouped context, "22 Sat" does not tell you
 * which month it is.
 */
const next = events.filter((e) => !e.past).slice(0, 4);
---

<section class="section" id="races">
  <div class="wrap">
    <div class="events-head reveal">
      <div>
        <h2>Coming Up</h2>
        <p class="body-lg">
          {next.length ? "What's on over the next few weekends." : 'Nothing on the calendar just yet.'}
        </p>
      </div>
      <a class="cta" href="/races/" data-brand="calendar">
        <svg class="ico" aria-hidden="true"><use href="#i-calendar"></use></svg>
        <span>Full Calendar</span>
      </a>
    </div>

    {next.length > 0 && (
      <div class="reveal" data-delay="1">
        <EventList events={next} showMonth />
      </div>
    )}
  </div>
</section>
