---
import EpisodeList from './EpisodeList.astro';
import { site } from '../data/site.js';

/**
 * Two columns where there is room: copy left, episodes right. Below 900px they
 * stack, copy first.
 *
 * The section is pulled up under the sticky header so the background photo runs
 * to the top of the page — without that the header is transparent over the page
 * background rather than the image, which just reads as a white bar.
 *
 * Emphasis in the tagline is weight, not colour: a mid-tone accent cannot reach
 * 4.5:1 against a photograph containing both white shoes and black shorts.
 */
---

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 class="reveal">{site.name}</h1>
      <p class="hero-sub reveal">A podcast for the <em>mediocre runner</em>.</p>
      <p class="lede reveal" data-delay="1">
        {site.hosts.join(' and ')} cover endurance events around the Upper Midwest.
      </p>
    </div>

    <EpisodeList />
  </div>
</section>
