---
import { ClientRouter } from 'astro:transitions';
import IconSprite from '../components/IconSprite.astro';
import Loader from '../components/Loader.astro';
import { site, links } from '../data/site.js';
import '../styles/main.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
} = Astro.props;

const ogImage = new URL('/assets/og-image.png', site.url).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: site.name,
  description: `${site.tagline}. Covering Midwest endurance events including running, biking, hiking and more.`,
  image: ogImage,
  url: `${site.url}/`,
  inLanguage: 'en',
  author: site.hosts.map((name) => ({ '@type': 'Person', name })),
  sameAs: [links.spotify, links.instagram, links.strava],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1112" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site.url}/`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="canonical" href={`${site.url}/`} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${site.url}/feed.xml`} />
    <link rel="icon" href="/assets/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/icon-512.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Inter:wght@400;500;600;700&display=swap"
    />

    {/* Runs before the body paints so a chosen theme never flashes the other
        one, and raises the loading curtain. Inline and tiny on purpose — an
        external file would load too late for either job. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;

        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t);
        } catch (e) {}

        // The curtain goes up here and comes down in loader.js. This script is
        // the only place that can promise both: it is inline, so it cannot fail
        // to load, and it arms its own failsafe before showing anything. If the
        // module bundle never arrives, the site still appears — a few seconds
        // late rather than never.
        d.classList.add('is-loading');
        setTimeout(function () {
          d.classList.remove('is-loading');
        }, 4000);
      })();
    </script>

    {/* Client-side routing exists for one reason: the player bar carries
        transition:persist, so an episode keeps playing while you move between
        pages. A plain multi-page navigation tears down the <audio> element and
        the show stops mid-sentence. */}
    <ClientRouter />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <IconSprite />
    <Loader />
    <slot />
  </body>
</html>

{/* Every page needs these, so they live in the layout rather than being
    re-imported by each one — which is how the multi-page split first shipped
    with none of them loading at all outside the home page. Astro bundles this
    once and each script re-initialises itself on astro:page-load. */}
<script>
  import '../scripts/loader.js';
  import '../scripts/theme.js';
  import '../scripts/player.js';
  import '../scripts/reveal.js';
  import '../scripts/header.js';
  import '../scripts/calendar.js';
</script>

